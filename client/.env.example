# ==========================================================
# Variables de entorno del cliente Astro/React (copiar a client/.env)
# En Jenkins subir como credencial Secret file con ID: reporteador-client-env-file
# NUNCA subir client/.env real a Git ni a Jenkins SCM.
# ==========================================================

# URL base del API para el cliente Astro/React
# En desarrollo local apunta directo al backend; detrás de Nginx en Docker usa /api
PUBLIC_API_URL=http://localhost:4000/api

# URL base del servicio de login (api_login_v2)
# Detrás de Nginx en Docker usa /apilogin (proxy a http://api_login_v2:80/api/v1/); en desarrollo local sin Nginx apunta directo al API de login
PUBLIC_LOGIN_API_URL=/apilogin
