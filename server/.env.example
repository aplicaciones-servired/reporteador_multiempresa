# Servidor HTTP
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:4321,http://127.0.0.1:4321

# Autenticación JWT (debe coincidir con api_login_v2 o definir LOGIN_JWT_SECRET aparte)
JWT_SECRET=cambia-esta-clave-secreta-en-produccion-min-32-chars
JWT_EXPIRES_IN=8h
# LOGIN_JWT_SECRET=
# AUTH_COOKIE_NAMES=access_token,token,jwt,auth_token,rm_token
COOKIE_SECURE=false

# Modo de base de datos de aplicación: local_file | legacy_mysql | sequelize
APP_DB_MODE=local_file
LOCAL_DB_FILE=./data/local-db.json

# Base de datos propia o legada (Sequelize: mysql o postgres)
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=reporteador_multiempresa
DB_USER=root
DB_PASSWORD=

# Seed inicial (usuario admin)
SEED_DEFAULT_ADMIN_PASSWORD=Admin123*

# Oracle Instant Client (opcional; omitir para usar Thin Mode en Oracle 12.1+)
ORACLE_CLIENT_LIB_DIR=

# Pool Oracle Principal (BDCT009)
ORACLE_PRINCIPAL_CONNECT_STRING=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=10.184.39.10)(PORT=1521))(CONNECT_DATA=(SID=BDCT009)))
ORACLE_PRINCIPAL_USER=
ORACLE_PRINCIPAL_PASSWORD=

# Pool Oracle Réplica (BDMM028)
ORACLE_REPLICA_CONNECT_STRING=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=10.167.27.90)(PORT=1521))(CONNECT_DATA=(SID=BDMM028)))
ORACLE_REPLICA_USER=
ORACLE_REPLICA_PASSWORD=

# Pool Oracle NAOS (BDTN002)
ORACLE_NAOS_CONNECT_STRING=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=10.195.39.40)(PORT=1521))(CONNECT_DATA=(SID=BDTN002)))
ORACLE_NAOS_USER=
ORACLE_NAOS_PASSWORD=

# Tabla histórica BENELITE (configurable para evitar tabla fija mensual en SQL)
ORACLE_BENELITE_HIST_TABLE=HIST_APUESTAS_AGO2025@BENELITE
