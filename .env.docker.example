# ==========================================================
# Plantilla de entorno para Docker Compose y Server (copiar a .env)
# En Jenkins subir como credencial Secret file con ID: reporteador-server-env-file
# NUNCA subir el archivo .env real a Git ni a Jenkins SCM.
# ==========================================================

# Etiquetas e imágenes
IMAGE_PREFIX=reporteador-multiempresa
IMAGE_TAG=latest
WEB_PORT=8080

# Backend HTTP / Seguridad
NODE_ENV=production
PORT=4000
TZ=America/Bogota
CLIENT_ORIGIN=http://localhost:8080
# JWT_SECRET debe coincidir con el de api_login_v2 (o configurar LOGIN_JWT_SECRET si api_login_v2 usa un secreto distinto)
JWT_SECRET=reemplazar-por-clave-secreta-aleatoria-min-32-caracteres
JWT_EXPIRES_IN=8h
# LOGIN_JWT_SECRET=
# AUTH_COOKIE_NAMES=access_token,token,jwt,auth_token,rm_token
# Cambiar a true si Nginx/Proxy termina TLS (HTTPS) en producción
COOKIE_SECURE=false

# Base de datos de aplicación: local_file | legacy_mysql | sequelize
APP_DB_MODE=legacy_mysql
LOCAL_DB_FILE=./data/local-db.json
DB_DIALECT=mysql
DB_HOST=172.20.1.92
DB_PORT=3306
DB_NAME=bdpersona
DB_USER=
DB_PASSWORD=

# Seed inicial (solo aplica si APP_DB_MODE=local_file o al ejecutar seed)
SEED_DEFAULT_ADMIN_PASSWORD=

# Oracle Instant Client dentro del contenedor Linux
ORACLE_CLIENT_LIB_DIR=/opt/oracle/instantclient

# Pool Oracle Principal (BDCT009)
ORACLE_PRINCIPAL_CONNECT_STRING=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=10.184.39.10)(PORT=1521))(CONNECT_DATA=(SID=BDCT009)))
ORACLE_PRINCIPAL_USER=
ORACLE_PRINCIPAL_PASSWORD=

# Pool Oracle Réplica (BDMM028)
ORACLE_REPLICA_CONNECT_STRING=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=10.167.27.90)(PORT=1521))(CONNECT_DATA=(SID=BDMM028)))
ORACLE_REPLICA_USER=
ORACLE_REPLICA_PASSWORD=

# Pool Oracle NAOS (BDTN002)
ORACLE_NAOS_CONNECT_STRING=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=10.195.39.40)(PORT=1521))(CONNECT_DATA=(SID=BDTN002)))
ORACLE_NAOS_USER=
ORACLE_NAOS_PASSWORD=

# Tabla histórica BENELITE
ORACLE_BENELITE_HIST_TABLE=HIST_APUESTAS_AGO2025@BENELITE
